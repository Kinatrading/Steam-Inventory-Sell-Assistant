{
  "manifest_version": 3,
  "name": "Steam Inventory Sell Assistant",
  "version": "1.0.1",
  "description": "Парсинг інвентарю, перевірка цін, історія BUY/SELL та виставлення предметів на продаж.",
  "action": {
    "default_title": "Open Inventory Sell Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/market/listings/730/*"
      ],
      "js": [
        "market-normal-toggle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "skins.json",
        "skins_compact.json"
      ],
      "matches": [
        "https://steamcommunity.com/*"
      ]
    }
  ]
}
