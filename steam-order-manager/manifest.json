{
  "manifest_version": 3,
  "name": "Steam Order Manager",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Keep configured Steam buy orders replenished at your chosen price and quantity.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://steamcommunity.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Steam Order Manager"}
}
